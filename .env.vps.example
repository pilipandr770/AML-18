# Production settings for docker-compose.vps.yml. Copy to .env.vps on the server (never commit it).
# scripts/deploy_vps.sh generates the secrets for you; this file documents every value.

AML_DOMAIN=aml.example.com
# Traefik certificate resolver on the host: "letsencrypt" (HTTP challenge) or "cfdns" (Cloudflare DNS challenge).
TRAEFIK_CERTRESOLVER=letsencrypt

POSTGRES_PASSWORD=
SECRET_KEY=

# --- hosted-platform safety (all recommended ON for a shared pilot) ---
PLATFORM_ADMIN_ENABLED=true
REVIEW_UI_REQUIRE_OPERATOR=true
SIGNUP_APPROVAL_REQUIRED=true
SIGNUP_RATE_LIMIT_PER_HOUR=10
AGENT_MAX_CASES_PER_DAY=100
TRUSTED_PROXIES=1
OWNER_COOKIE_SECURE=true
UI_LOCALE=en

# --- agent ---
AGENT_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AGENT_LLM_TIMEOUT_SECONDS=20
AGENT_LLM_MAX_CALLS_PER_MINUTE=20
# "evm" = read-only Sepolia testnet RPC (no key needed for a public node); "mock" = deterministic ledger.
AGENT_CHAIN_ADAPTER=evm
AGENT_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_MIN_CONFIRMATIONS=3
AGENT_EXECUTOR=webhook

# --- billing off during a free pilot ---
BILLING_ENABLED=false

# --- sanctions lists ---
SANCTIONS_CRON_INTERVAL_SECONDS=86400
SANCTIONS_STALENESS_WARNING_DAYS=3

# Optional digest email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public site assistant (answers from app/assistant/knowledge.md; rate-limited, daily cap)
ASSISTANT_ENABLED=true
ASSISTANT_PER_MINUTE=8
ASSISTANT_DAILY_CAP=300
